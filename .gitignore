## ───────────── Laravel core ─────────────

/node_modules/
/bootstrap/compiled.php
/bootstrap/cache/*.php
/bootstrap/cache/*.json
!/bootstrap/cache/.gitignore
/public/storage
/public/hot
yarn-error.log
npm-debug.log
package-lock.json
composer.lock
*.lock

## ───────────── Environment & secrets ─────────────

.env
.env.*
.env.backup
.env.production
.env.local
.env.*.php
.env.php
*.pem
*.key
auth.json
oauth-private.key
oauth-public.key
storage/oauth-private.key
storage/oauth-public.key

## ───────────── Storage / runtime ─────────────
/storage/*.key
/storage/debugbar/
/storage/logs/*.log
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/livewire-tmp/

## ───────────── Public uploads (NEVER commit user content) ─────────────
/public/uploads/
/public/uploads.zip
/public/storage
/public/all
/public/app-translations/
/public/assets/css/critical/        # auto-generated by SEO critical-CSS pipeline

## ───────────── IDE / editor / OS ─────────────
.idea/
.vscode/
.vagrant/
*.iml
.nbproject/
nbproject/
nbproject/private/
.fleet/
.history/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

## ───────────── IDE helper autogenerated ─────────────
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

## ───────────── Build / vendor outputs ─────────────
/public/mix-manifest.json
/public/css/build/
/public/js/build/
/public/build/
public/css.map
public/js.map

## ───────────── Database dumps & backups (LARGE — keep out of git) ─────────────
*.sql
*.sqlite
*.sqlite3
*.db
shop.sql
virajaiv_*.sql
sqlupdates/*.sql
!sqlupdates/.gitkeep

## ───────────── ALL archives (.zip never committed, anywhere in tree) ─────────────
*.zip
**/*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.gz
*.bz2
bhssupllies*.zip
bhssupplies-*.zip
updates.zip
ecommerce.zip
install.zip
addons/*.zip
public/*.zip
storage/*.zip
updates/

## ───────────── One-off / debug / temp scripts ─────────────
debug_*.php
debug_hansler*.php
seo_test.php
check_*.php
get_*.php
bulk_*.php
update_nap.php
update_seo_settings*.php
fix_*.php
temp/
tmp/
storage/temp/

## ───────────── Logs & error dumps ─────────────
*.log
error.txt
error_log
laravel.log

## ───────────── Site-verification & DNS proof files ─────────────
# (each verification file identifies who owns the domain — keep private)
google*.html
BingSiteAuth.xml
y_key_*.html
yandex_*.html

## ───────────── Generated language packs ─────────────
resources/lang/en.json

## ───────────── Claude Code workspace ─────────────
/.claude/
.claude/

## ───────────── Composer global / dev artefacts ─────────────
.phpunit.result.cache
.phpunit.cache/
phpunit.xml.bak
.php-cs-fixer.cache
.rector.cache

## ───────────── Cron / WAMP / Windows-specific ─────────────
*.bat.old
wp-cli.local.yml

